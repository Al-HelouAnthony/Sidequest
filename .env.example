# Copy to .env.local and fill in. NEVER commit .env.local.
# Ask Anthony for the shared values (send them over a private channel, not the repo).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: bypasses RLS

# --- Claude ---
ANTHROPIC_API_KEY=                # server only

# --- Google OAuth + Calendar (Anthony's Google Cloud project) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=             # server only

# --- OpenRouteService (openrouteservice.org → dashboard → API key) ---
ROUTING_API_KEY=                  # server only

# --- Safety switches (default true = demo-safe) ---
USE_MOCK_DATA=true                # false = read real data from Supabase / APIs
DEMO_MODE=true                    # true = "log in as" cookie auth; false = Supabase Google auth only

# --- Demo data (Adel) ---
SEED_SECRET=                      # server only: header x-seed-secret for POST /api/dev/seed (any long random string)
FORCE_RAIN_SAT=false              # true = Saturday 13:00–18:00 is rainy (staged demo of weather filtering)
